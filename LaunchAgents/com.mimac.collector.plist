<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mimac.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MIMACD_PATH__</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.mimac.collector</key>
        <true/>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/com.mimac.collector.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.mimac.collector.stderr.log</string>
</dict>
</plist>
